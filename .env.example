# --------------------------------------------------------------------
# 生产环境专用环境变量配置 (.env.example)
#
# 使用方法：
# 1. 复制此文件并重命名为 .env
# 2. 根据您的生产环境修改配置
# 3. 运行启动命令: docker-compose up -d
# --------------------------------------------------------------------

# ==================== 1. 前端配置 ====================
# 暴露的 HTTP 和 HTTPS 端口
FRONTEND_HTTP_PORT=80
FRONTEND_HTTPS_PORT=443

# ==================== 2. 后端核心安全配置 ====================
# JWT 签名密钥（极其重要！生产环境务必修改为超长随机字符）
JWT_SECRET=YourProductionVeryLongAndSecureSecretKeyGeneratedHere123456789

# ==================== 3. 数据库连接配置 (PostgreSQL) ====================
# PostgreSQL 部署使用的版本标签 (默认为 15-alpine)
POSTGRES_VERSION=15-alpine
DB_HOST=db
DB_PORT=5432
DB_NAME=activation_db
DB_USER=activate_admin
# （重要）请更改您的默认密码
DB_PASSWORD=YourProductionSuperSecretPassword

# ==================== 4. 初始管理员账户 ====================
# 首次运行 docker-compose 时会自动将此账户注入数据库。之后修改无效。
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!

# ==================== 5. 邮件服务配置 ====================
# 必填项，生产环境用户找回密码和激活码依赖于此
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=no-reply@example.com
SMTP_PASS=YourEmailPassword

# ==================== 6. 安全验证 (FIDO2/通行密钥) 配置 ====================
# FIDO2 Server Domain 必须与实际访问的域名(不包含协议和端口)匹配
# 如果用户通过 https://activate.example.com 访问系统，则此处填 activate.example.com
FIDO2_SERVER_DOMAIN=localhost

# FIDO2 Origin 必须与浏览器地址栏中的完整源地址(包括协议和端口，除非是默认端口)完美匹配
# 例如 https://activate.example.com
FIDO2_ORIGIN=https://localhost
