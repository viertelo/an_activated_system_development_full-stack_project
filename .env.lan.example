# --------------------------------------------------------------------
# 局域网部署专用环境变量配置 (.env.lan.example)
#
# 此配置移除了强制 HTTPS 所需的参数，仅保留最简核心运行所需配置，
# 且不会影响生产环境服务器使用的 .env 及其对应的 docker-compose.yml。
# 
# 使用方法：
# 1. 复制此文件并重命名为 .env.lan
# 2. 根据您的内网环境修改配置
# 3. 运行启动命令: docker-compose -f docker-compose.lan.yml --env-file .env.lan up -d
# --------------------------------------------------------------------

# ==================== 1. 前端配置 ====================
# 局域网暴露的 HTTP 端口（无需配置 HTTPS 端口）
FRONTEND_HTTP_PORT=8080

# ==================== 2. 后端核心安全配置 ====================
# JWT 签名密钥（极其重要！局域网环境也请务必修改为一长串随机字符）
JWT_SECRET=YourVeryLongAndSecureSecretKeyGeneratedHere123456789

# ==================== 3. 数据库连接配置 (PostgreSQL) ====================
DB_HOST=db
DB_PORT=5432
DB_NAME=activation_db_lan
DB_USER=activate_admin_lan
# （重要）即使在局域网，也请更改您的默认密码
DB_PASSWORD=YourSuperSecretLanPassword

# ==================== 4. 初始管理员账户 ====================
# 首次运行 docker-compose 时会自动将此账户注入数据库。之后修改无效。
ADMIN_EMAIL=admin@local.lan
ADMIN_PASSWORD=Admin123!

# ==================== 5. 邮件服务配置 ====================
# 用于局域网找回密码/激活码（可选：如果内网无邮件系统，可留空，但找回密码功能将不可用）
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=no-reply@example.com
SMTP_PASS=YourEmailPassword

# ==================== 6. 安全验证 (FIDO2/通行密钥) 配置 ====================
# 局域网访问时，必须填入内网 IP 地址或者局域网解析的域名 (如 192.168.1.100)
# 若通过 https://192.168.1.100 访问，则填写 192.168.1.100
FIDO2_SERVER_DOMAIN=192.168.1.100

# 必须与浏览器地址栏完全匹配，且建议使用 HTTPS 以满足安全要求（如果不是 localhost，FIDO2 强行要求 HTTPS）
# 若端口非 443 也要加上，如 https://192.168.1.100:8443
FIDO2_ORIGIN=https://192.168.1.100
